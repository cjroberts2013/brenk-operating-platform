# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both are public values that ship to the browser bundle; safe to commit
# the *.example file with the keys empty.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The backend API base URL. In dev, the FastAPI server runs at :8000.
# In production, this will be the deployed Fly.io URL.
#
# NOTE: use 127.0.0.1 (not "localhost") for the dev value. Uvicorn binds
# to IPv4 by default, but Node's fetch resolves localhost to IPv6 first
# (::1) and gets ECONNREFUSED. Forcing IPv4 here avoids the dual-stack
# split-brain.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ServiceChannel web UI host. Used to build "Open in ServiceChannel"
# deep links from a work order's SC id. Sandbox vs production:
#   sandbox    https://sb2.servicechannel.com
#   production https://www.servicechannel.com
# (NOT sc.servicechannel.com — that host doesn't resolve; verified
#  www.servicechannel.com/sc/wo/Workorders/index?id=… works 2026-06-14.)
NEXT_PUBLIC_SC_WEB_URL=https://sb2.servicechannel.com
