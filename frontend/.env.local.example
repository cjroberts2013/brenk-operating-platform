# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both are public values that ship to the browser bundle; safe to commit
# the *.example file with the keys empty.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The backend API base URL. In dev, the FastAPI server runs at :8000.
# In production, this will be the deployed Fly.io URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
