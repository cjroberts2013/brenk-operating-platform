# =============================================================================
# Brenk Operating Platform — Backend Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development             # development | staging | production
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
DEBUG=true

# -----------------------------------------------------------------------------
# Database (Supabase Postgres)
# -----------------------------------------------------------------------------
# Get from Supabase dashboard → Project Settings → Database → Connection string
DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@HOST:5432/postgres
# Async version for SQLAlchemy async engine
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:PASSWORD@HOST:5432/postgres

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=                # public anon key for client-side
SUPABASE_SERVICE_ROLE_KEY=        # service role key — backend only, very sensitive
SUPABASE_JWT_SECRET=              # for verifying JWTs from Supabase Auth

# -----------------------------------------------------------------------------
# ServiceChannel API
# -----------------------------------------------------------------------------
# Environment switch: 'sandbox' or 'production'
SC_ENVIRONMENT=sandbox

# Sandbox endpoints (Sandbox2)
SC_SANDBOX_LOGIN_URL=https://sb2login.servicechannel.com
SC_SANDBOX_API_URL=https://sb2api.servicechannel.com

# Production endpoints
SC_PRODUCTION_LOGIN_URL=https://login.servicechannel.com
SC_PRODUCTION_API_URL=https://api.servicechannel.com

# App credentials (from ServiceChannel App Registration)
SC_CLIENT_ID=
SC_CLIENT_SECRET=

# User credentials (Brenk's ServiceChannel account)
SC_USERNAME=
SC_PASSWORD=

# -----------------------------------------------------------------------------
# Sync configuration
# -----------------------------------------------------------------------------
# Sync schedule is wired in code via Procrastinate's @periodic(cron=...).
# Currently every 5 minutes — see app/workers/tasks.py.
SC_REQUEST_TIMEOUT_SECONDS=30
SC_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# AI provider keys (for later phases). Server-side secrets — never commit the
# real values; set them in .env locally and via `fly secrets` in prod.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Email (Resend) — powers the storefront "Request a Quote" form.
# If RESEND_API_KEY is empty, quote submissions are still accepted and
# logged (lead not lost) but no email is sent.
#   QUOTE_FROM_EMAIL: must be on a Resend-verified domain in prod. The
#     default onboarding@resend.dev only delivers to the Resend account
#     owner's email until brenkfacilityservices.com is verified.
#   QUOTE_TO_EMAIL: where leads are sent. Dev points at the developer's
#     inbox; prod should be daryl@brenkfacilityservices.com.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
QUOTE_FROM_EMAIL=Brenk Facility Services <quotes@brenkfacilityservices.com>
QUOTE_TO_EMAIL=daryl@brenkfacilityservices.com
# Recipient for the daily turnaround-deadline digest. Empty = falls back
# to QUOTE_TO_EMAIL. Point it at the developer's inbox while verifying
# the digest so Daryl isn't flooded before it's trusted.
REMINDER_TO_EMAIL=

# -----------------------------------------------------------------------------
# SMS (Twilio) — powers vendor work-order notification texts (with photos
# as MMS). If the credentials are empty, the send-vendor-sms endpoint
# returns a "not configured" error; nothing else breaks.
#   TWILIO_FROM_NUMBER: the purchased Twilio number in E.164 form
#     (e.g. +15125551234). US delivery requires A2P 10DLC registration
#     (or a verified toll-free number) in the Twilio console — unregistered
#     traffic gets carrier-filtered.
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Secret key for any internal signing (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=
